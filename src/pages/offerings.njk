---
layout: layouts/base.njk
title: Propositions artistiques
permalink: /propositions-artistiques/index.html
---
<div class="page">
  <header class="page-head">
    <p class="kicker">Propositions artistiques</p>
    <h1>Ce que font les Créatures</h1>
    <p class="page-lede">Du cabaret au défilé, de la lecture en médiathèque au DJ set : des formes à inviter dans vos lieux, vos écoles, vos scènes et vos nuits.</p>
  </header>

  {% for offering in collections.offerings | sortByOrder %}
    <section class="offering" id="{{ offering.fileSlug }}">
      <h2>{{ offering.data.title }}</h2>
      {{ offering.templateContent | safe }}
      <p class="offering-price">{{ offering.data.price }}</p>
    </section>
  {% endfor %}

  <a class="btn btn-flame" href="/contact/">Demander un devis</a>
</div>
