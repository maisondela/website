---
layout: layouts/base.njk
title: Galerie
permalink: /galerie/index.html
---
<div class="page page-wide">
  <header class="page-head">
    <p class="kicker">Galerie</p>
    <h1>En images</h1>
    <p class="page-lede">Cabarets, défilés et scènes ouvertes vus par celles et ceux qui les photographient.</p>
  </header>

  <div class="gallery">
    {% for item in gallery.images %}
      <figure class="gallery-item" style="background-image: url({{ item.image | lqip }})">
        <img src="{{ item.image }}" alt="{{ item.caption or "Visuel de la Maison De La" }}" sizes="(max-width: 36rem) 100vw, 33vw" eleventy:widths="480,800">
      </figure>
    {% endfor %}
  </div>
</div>
