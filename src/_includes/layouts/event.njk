---
layout: layouts/base.njk
---
<article class="page">
  <header class="page-head">
    <p class="kicker">Agenda</p>
    <h1>{{ title }}</h1>
    <p class="event-meta">
      <time datetime="{{ date | isoDate }}">{{ date | formatDateTime }}</time><br>
      {{ location }}
    </p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <a class="back-link" href="/agenda/">← Tout l'agenda</a>
</article>
