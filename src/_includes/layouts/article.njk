---
layout: layouts/base.njk
---
<article class="page">
  <header class="page-head">
    <p class="kicker">Actualités</p>
    <h1>{{ title }}</h1>
    <p class="article-meta">
      Publié le <time datetime="{{ date | isoDate }}">{{ date | formatDate }}</time>
    </p>
  </header>
  {% if image %}
    <img class="article-cover" src="{{ image }}" alt="">
  {% endif %}
  <div class="prose">
    {{ content | safe }}
  </div>
  <a class="back-link" href="/actualites/">← Toutes les actualités</a>
</article>
