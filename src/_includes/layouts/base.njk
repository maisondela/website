<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ association.name }}</title>
  <meta name="description" content="{{ description or association.description }}">
  <meta name="theme-color" content="#1b1015">
  <link rel="preload" href="/assets/fonts/bodoni-moda.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  {% include "components/header.njk" %}
  <main id="content">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
</body>
</html>
