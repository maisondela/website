{% macro eventRow(event) %}
<a class="program-row" href="{{ event.url }}">
  <span class="program-day">
    {{ event.data.date | dayNumber }}
    <span class="program-month">{{ event.data.date | monthShort }}</span>
  </span>
  <span>
    <span class="program-title">{{ event.data.title }}</span>
    <span class="program-meta">
      <time datetime="{{ event.data.date | isoDate }}">{{ event.data.date | formatDateTime }}</time>
      — {{ event.data.location }}
    </span>
  </span>
  <span class="program-arrow" aria-hidden="true">→</span>
</a>
{% endmacro %}
